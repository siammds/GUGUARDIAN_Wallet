# Guardian Wallet Environment Configuration

# Application Mode: "demo" or "live"
APP_MODE=demo
DEMO_MODE=true

# Backend API Configuration
API_PORT=8000
API_HOST=0.0.0.0
API_BASE_URL=http://localhost:8000
DATABASE_URL=sqlite:///./guardian_wallet.db
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,capacitor://localhost,http://localhost

# Optional AI Provider Configuration (Optional - Demo mode works locally without any API key)
# Supported: "none", "gemini", "openai"
LLM_PROVIDER=none
LLM_API_KEY=

# Blockchain Network Configuration (Sepolia EVM Testnet by default)
CHAIN_ID=11155111
RPC_URL=https://rpc.sepolia.org
EXPLORER_BASE_URL=https://sepolia.etherscan.io

# Safe / Policy Guard (Optional contract address if deployed on testnet)
GUARDIAN_CONTRACT_ADDRESS=
TEST_TOKEN_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
